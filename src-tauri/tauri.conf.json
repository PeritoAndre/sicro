{
  "$schema": "https://schema.tauri.app/config/2.0.0",
  "productName": "SICRO",
  "version": "6.0.0",
  "identifier": "br.org.sicro.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "SICRO 6.0",
        "width": 1440,
        "height": 900,
        "minWidth": 1100,
        "minHeight": 700,
        "resizable": true,
        "decorations": false,
        "fullscreen": false,
        "center": true,
        "theme": "Dark",
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": {
          "allow": ["**"],
          "deny": []
        }
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "appimage", "nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Productivity",
    "publisher": "Polícia Científica do Amapá",
    "copyright": "© 2026 Polícia Científica do Amapá",
    "licenseFile": "installer/termo-de-uso.txt",
    "shortDescription": "Suíte pericial SICRO",
    "longDescription": "Sistema Integrado de Criminalística e Operações — croquis, vídeo e áudio e imagem para o perito criminal, com custódia das evidências.",
    "linux": {
      "appimage": {
        "bundleMediaFramework": true
      },
      "deb": {
        "depends": ["ffmpeg", "libimage-exiftool-perl", "gstreamer1.0-plugins-good", "gstreamer1.0-libav"]
      },
      "rpm": {
        "depends": ["/usr/bin/ffmpeg", "/usr/bin/exiftool"]
      }
    },
    "windows": {
      "nsis": {
        "installMode": "both",
        "languages": ["PortugueseBR"],
        "displayLanguageSelector": false,
        "installerIcon": "icons/icon.ico",
        "headerImage": "installer/header.bmp",
        "sidebarImage": "installer/sidebar.bmp"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEFBRDI4MDUwOTJGQ0E0NEMKUldSTXBQeVNVSURTcW04ZDB3UkFzRmdCZENZaVVaK09ValVMandKTjlsa3dNMHB3SkFtMmsvVlYK",
      "endpoints": ["https://github.com/PeritoAndre/sicro/releases/latest/download/latest.json"],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
